{
  "name": "video-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:remotion": "npm --workspace @video-studio/remotion-studio run dev",
    "render:remotion": "npm --workspace @video-studio/remotion-studio run render",
    "dev:motion-canvas": "npm --workspace @video-studio/motion-canvas-studio run dev",
    "smoke": "node scripts/smoke-foundation.mjs",
    "verify:deps": "node scripts/verify-dependency-contract.mjs",
    "verify:render": "node scripts/verify-render.mjs",
    "validate:demo": "node scripts/validate-project.mjs projects/demo-product/project.json",
    "validate:advanced": "node scripts/validate-project.mjs projects/advanced-visuals-demo/project.json",
    "test:productization": "node scripts/test-productization.mjs",
    "create:project": "node scripts/create-project.mjs",
    "check": "node scripts/check-env.mjs && npm run smoke && npm run validate:advanced && npm run test:productization && npm run typecheck",
    "probe": "node scripts/probe-media.mjs",
    "postprocess": "node scripts/postprocess.mjs",
    "render": "node scripts/render.mjs",
    "render:advanced": "node scripts/render.mjs projects/advanced-visuals-demo/project.json",
    "extract:advanced-qa": "node scripts/extract-qa-frames.mjs projects/advanced-visuals-demo/project.json",
    "verify:advanced-qa": "node scripts/verify-qa-frames.mjs projects/advanced-visuals-demo/project.json",
    "typecheck:remotion": "npm --workspace @video-studio/remotion-studio run typecheck",
    "typecheck:motion-canvas": "npm --workspace @video-studio/motion-canvas-studio run typecheck",
    "typecheck": "npm run typecheck:remotion && npm run typecheck:motion-canvas",
    "fixtures:media": "node scripts/generate-media-fixtures.mjs",
    "render:derivatives": "node scripts/render-derivatives.mjs",
    "verify:media-stack": "node scripts/verify-media-stack.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
