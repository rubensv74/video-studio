# Video Studio runtime profile: local | ci | production
VIDEO_STUDIO_PROFILE=local

# Optional Control Plane authentication.
# Runtime-only JSON map. Never commit real tokens.
# VIDEO_STUDIO_TOKENS_JSON={"example-token":{"subject":"operator@example","role":"operator"}}

# Cross-origin Control Plane UI origins, comma-separated.
# Leave empty for same-origin/local proxy mode.
# VIDEO_STUDIO_ALLOWED_ORIGINS=https://video-studio.example.vercel.app

# Production render-worker binding.
# Required when VIDEO_STUDIO_PROFILE=production.
# VIDEO_STUDIO_WORKER_URL=https://worker.example.com
# VIDEO_STUDIO_WORKER_CREDENTIAL_REF=env:VIDEO_STUDIO_WORKER_TOKEN
# VIDEO_STUDIO_WORKER_TOKEN=

# Production operational-store provider: http | supabase
# VIDEO_STUDIO_STORE_PROVIDER=supabase

# Generic HTTP store configuration.
# VIDEO_STUDIO_STORE_URL=https://store.example.com
# VIDEO_STUDIO_STORE_CREDENTIAL_REF=env:VIDEO_STUDIO_STORE_TOKEN
# VIDEO_STUDIO_STORE_TOKEN=

# Supabase store configuration.
# VIDEO_STUDIO_SUPABASE_URL=https://<project-ref>.supabase.co
# VIDEO_STUDIO_SUPABASE_SECRET_REF=env:VIDEO_STUDIO_SUPABASE_SECRET_KEY
# VIDEO_STUDIO_SUPABASE_SCHEMA=video_studio_api
# VIDEO_STUDIO_SUPABASE_SECRET_KEY=

# Vite Control Plane UI: build-time URL of the separately hosted backend.
# VITE_CONTROL_PLANE_API_BASE_URL=https://control-plane-api.example.com

# A secret:<path> reference is supported when the server is started with an
# injected external secretProvider adapter.

# Optional media/AI providers. Keep real credentials in runtime secret stores.
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# Optional Remotion/AWS deployment settings.
# AWS_REGION=
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=
