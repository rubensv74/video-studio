# Optional external services. Core rendering works without them.
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# AWS_REGION=
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=

# Control Plane governance.
# Secure default: authentication is enabled.
# For LOCAL DEVELOPMENT ONLY, explicitly disable it:
VIDEO_STUDIO_AUTH_DISABLED=true

# Production/secured example (replace tokens; never commit real values):
# VIDEO_STUDIO_AUTH_DISABLED=false
# VIDEO_STUDIO_API_KEYS={"replace-viewer-key":{"role":"viewer","subject":"viewer"},"replace-operator-key":{"role":"operator","subject":"operator"},"replace-admin-key":{"role":"admin","subject":"admin"}}

VIDEO_STUDIO_STATE_FILE=.video-studio/control-plane-state.json
